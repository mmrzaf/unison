# Copy to keystore.properties only when already have a signing key.
# Prefer ./scripts/create-release-key.sh for a new release key.
storeFile=keystore/unison-release.jks
storePassword=replace-me
keyAlias=unison
keyPassword=replace-me
# Public SHA-256 fingerprint of the signing certificate, 64 hex digits (colons are also accepted).
certificateSha256=replace-with-certificate-sha256
